<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CA1031</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Dev-only headless verification of the shipping leaf source. -->
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <Compile Include="Program.cs" />
    <Compile Include="../../../MagicalCryptoWallet/Mcw/IMcwApplicationServices.cs" Link="IMcwApplicationServices.cs" />
    <Compile Include="../../../MagicalCryptoWallet/Mcw/NativeUi/MarkdownPresentation.cs" Link="MarkdownPresentation.cs" />
    <Compile Include="../../../MagicalCryptoWallet.Fluent/Controls/ReleaseHighlightsText.cs" Link="ReleaseHighlightsText.cs" />
    <AvaloniaResource Include="../../../MagicalCryptoWallet.Fluent/Styles/ReleaseHighlights.axaml" Link="Styles/ReleaseHighlights.axaml" />
    <EmbeddedResource Include="../../../MagicalCryptoWallet.Fluent/Styles/Themes/Light.axaml" LogicalName="ShippingPalette.Light.axaml" />
    <EmbeddedResource Include="../../../MagicalCryptoWallet.Fluent/Styles/Themes/Dark.axaml" LogicalName="ShippingPalette.Dark.axaml" />
  </ItemGroup>
</Project>
