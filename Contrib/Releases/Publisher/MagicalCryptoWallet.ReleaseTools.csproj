<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MagicalCryptoWallet.ReleaseTools</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NBitcoin" />
    <PackageReference Include="NNostr.Client" />
    <EmbeddedResource Include="../../Signing/public-keys.json" LogicalName="MagicalCryptoWallet.ReleaseKeys.json" />
    <EmbeddedResource Include="../../Signing/package-suffixes.json" LogicalName="MagicalCryptoWallet.PackageSuffixes.json" />
    <InternalsVisibleTo Include="MagicalCryptoWallet.Tests" />
  </ItemGroup>
</Project>
