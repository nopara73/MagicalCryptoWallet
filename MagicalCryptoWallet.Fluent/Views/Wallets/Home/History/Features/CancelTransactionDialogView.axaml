<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:features="clr-namespace:MagicalCryptoWallet.Fluent.ViewModels.Wallets.Home.History.Features"
             xmlns:converters="clr-namespace:MagicalCryptoWallet.Fluent.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MagicalCryptoWallet.Fluent.Views.Wallets.Home.History.Features.CancelTransactionDialogView"
             x:DataType="features:CancelTransactionDialogViewModel"
             x:CompileBindings="True">

  <ContentArea Title="Cancel Transaction"
                 EnableCancel="{Binding EnableCancel}"
                 EnableBack="{Binding EnableBack}"
                 EnableNext="True" NextContent="Confirm"
                 IsBusy="{Binding IsBusy}"
                 MinWidth="500">

    <DockPanel>
      <Viewbox MaxHeight="120" Margin="40" DockPanel.Dock="Top">
        <PathIcon Data="{StaticResource cancel_regular}" Opacity="0.6" />
      </Viewbox>
      <StackPanel Spacing="10" HorizontalAlignment="Center">
        <TextBlock HorizontalAlignment="Center" Text="Total fee" />
        <PrivacyContentControl>
          <TextBlock Classes="h5" HorizontalAlignment="Center" Text="{Binding Fee.Usd^, Converter={x:Static converters:MoneyConverters.ToUsdFee}}" />
        </PrivacyContentControl>
      </StackPanel>
    </DockPanel>
  </ContentArea>
</UserControl>
